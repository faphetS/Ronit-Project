NODE_ENV=development
PORT=3000
BACKEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
TZ=Asia/Jerusalem

# --- Monday.com ---
# Personal API token from https://<account>.monday.com/apps/manage/tokens
# Optional today (no domain uses it yet); becomes required when the monday domain lands.
MONDAY_API_TOKEN=

# Board / group / column IDs — defaults in env.ts match the current CRM snapshot.
# Set these only if the CRM board structure changes.
MONDAY_BOARD_CRM_ID=
MONDAY_GROUP_NEW_LEADS_ID=
MONDAY_COL_PHONE_ID=
MONDAY_COL_SERVICE_ID=
MONDAY_COL_NOTES_ID=

# Service board IDs — items move here when a CRM lead is closed.
# Challah is the 2026 board; later-year boards auto-create on demand.
# Uman is the bootstrap flight board; later flights auto-create when the current
# flight's date passes. Current Uman board ID is persisted in SQLite.
MONDAY_BOARD_UMAN_ID=
MONDAY_BOARD_CHALLAH_ID=

# Uman board — per-row flight date column. Ronit fills this manually.
MONDAY_UMAN_COL_DATE_ID=

# --- Meta / Instagram ---
# Set when the Meta developer app is created and business verification is done.
META_APP_SECRET=
META_VERIFY_TOKEN=

# Optional IG auto-reply templates (code defaults exist; leave unset to use them,
# or override here — value must be non-empty; literal \n becomes a newline).
# Routing is (service) x (phone in message?) x (first contact vs. answer to the
# "challah or uman?" question). Only IG_MSG_UMAN_ANSWER_PHONE_MISSING and
# IG_MSG_COMMENT_UMAN still carry the teaser + {form_link}; the rest are short.
#   uman opener    + phone  -> IG_MSG_PHONE_PRESENT
#   uman opener    - phone  -> IG_MSG_PHONE_MISSING            (asks for phone)
#   challah opener + phone  -> IG_MSG_SERVICE_PHONE_PRESENT
#   challah opener - phone  -> IG_MSG_SERVICE_PHONE_MISSING    (asks for phone)
#   vague opener            -> IG_MSG_ASK_SERVICE              (challah or uman?)
#   answered uman  + phone  -> IG_MSG_UMAN_ANSWER_PHONE_PRESENT
#   answered uman  - phone  -> IG_MSG_UMAN_ANSWER_PHONE_MISSING ({form_link})
#   answered chal. + phone  -> IG_MSG_CHALLAH_ANSWER_PHONE_PRESENT
#   answered chal. - phone  -> IG_MSG_CHALLAH_ANSWER_PHONE_MISSING (asks for phone)
#   uman lead sends phone after being asked -> IG_MSG_PHONE_THANKS (one-time)
# IG_MSG_SERVICE_PHONE_PRESENT=
# IG_MSG_SERVICE_PHONE_MISSING=
# IG_MSG_PHONE_PRESENT=
# IG_MSG_PHONE_MISSING=
# IG_MSG_ASK_SERVICE=
# IG_MSG_UMAN_ANSWER_PHONE_PRESENT=
# IG_MSG_UMAN_ANSWER_PHONE_MISSING=
# IG_MSG_CHALLAH_ANSWER_PHONE_PRESENT=
# IG_MSG_CHALLAH_ANSWER_PHONE_MISSING=
# IG_MSG_PHONE_THANKS=

# --- SQLite ---
# Default lives on the Docker volume /opt/ronit-data → /data inside the container.
# Override for local dev (e.g. ./crm.sqlite) so writes don't require /data to exist.
DB_FILE_PATH=

# --- OpenRouter ---
# API key from https://openrouter.ai/keys. Required when the classifier is invoked.
OPENROUTER_API_KEY=
# Override to swap models without code changes.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Group ID for the "Closed" group — leads here won't be moved to Contacted on calls.
MONDAY_GROUP_CLOSED_ID=

# --- Salestrail — call recording webhook + Pull API ---
# Push API auth: both orgs are configured with THESE same credentials, so one
# webhook endpoint serves both. Pull API keys are generated per org, so each
# org needs its own pair; _2 is optional and only set when a 2nd org exists.
SALESTRAIL_WEBHOOK_USERNAME=
SALESTRAIL_WEBHOOK_PASSWORD=
SALESTRAIL_API_USERNAME=
SALESTRAIL_API_PASSWORD=
SALESTRAIL_API_USERNAME_2=
SALESTRAIL_API_PASSWORD_2=
# Audio transcription model — default is Gemini 2.5 Flash via OpenRouter.
OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash

# --- GreenAPI / WhatsApp ---
GREENAPI_API_URL=https://7103.api.greenapi.com
GREENAPI_INSTANCE_ID=
GREENAPI_API_TOKEN=
RONIT_OWNER_WA_NUMBER=

# --- CRM database (Postgres on the VPS) and the dashboard's sign-in ---
# Unset keeps the passport/greeting automations and sign-in off; nothing else changes.
DATABASE_URL=
# Sign-in is "Continue with Google" for registered emails, then a 6-digit code by email on a
# new device. It answers 503 until everything below is set.
# 64 hex characters (openssl rand -hex 32): seals the Google step's cookie, keys the codes.
AUTH_SECRET=
# Where the dashboard runs: where sign-in lands, and the Origin check. Its host passes /api/auth
# on to this server (dashboard/vercel.json), so the browser only ever talks to the dashboard.
DASHBOARD_URL=https://or-hatzadik-dashboard.vercel.app
# Google Cloud > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: <DASHBOARD_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP for the codes and invites. Gmail for now: smtp.gmail.com, port 465, the address, and an
# app password (myaccount.google.com/apppasswords; needs 2-Step Verification on).
# Resend later, once its DNS records are on the domain: smtp.resend.com, 465, user "resend", the API key.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Holiday and birthday greetings on WhatsApp, through Zernio (zernio.com) ---
# Every greeting text is a WhatsApp template Meta approves first. With the key and the account id,
# greetings go for review and test sends work; they go out to customers only with
# GREETINGS_ENABLED=true and GREETINGS_CHANNEL=zernio (and RONIT_WA_ALLOWED_NUMBERS open).
ZERNIO_API_KEY=
# The connected WhatsApp number's account id in Zernio (GET /v1/accounts).
ZERNIO_WHATSAPP_ACCOUNT_ID=
# The webhook: POST /v1/webhooks/settings with url https://api.ronitbarash.site/api/zernio/webhook,
# events whatsapp.template.status_updated, message.delivered, message.read, message.failed, and this secret.
ZERNIO_WEBHOOK_SECRET=
GREETINGS_ENABLED=false
GREETINGS_CHANNEL=dry-run

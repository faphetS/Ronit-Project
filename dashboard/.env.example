# The API's origin. Empty: the page's own origin, which Vercel (dashboard/vercel.json) and Vite pass on to the API
VITE_API_URL=
# The Google OAuth client ID (public). Set: the sign-in shows Google's own button
VITE_GOOGLE_CLIENT_ID=
# Where the dev server proxies /api (default http://localhost:3000)
# VITE_API_PROXY=http://localhost:3000

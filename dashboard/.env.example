# Fixed "today" for the demo data
VITE_DEMO_TODAY=2026-10-28
# Mock response delay range in milliseconds: min,max
VITE_MOCK_LATENCY=120,300
# Services that use Ronit's API: "session", a comma list, or "all". Unset: all on the demo data
VITE_HTTP_SERVICES=
# The API's origin in production (https://api.ronitbarash.site). Empty in development: /api is proxied
VITE_API_URL=
# Where the dev server proxies /api (default http://localhost:3000)
# VITE_API_PROXY=http://localhost:3000

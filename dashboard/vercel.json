{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/auth/(.*)", "destination": "https://api.ronitbarash.site/api/auth/$1" },
    { "source": "/api/dashboard/(.*)", "destination": "https://api.ronitbarash.site/api/dashboard/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
